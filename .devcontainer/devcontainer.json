{
  "name": "Euler's Method (Java)",
  "image": "mcr.microsoft.com/devcontainers/java:21",
  "customizations": {
    "vscode": {
      "extensions": ["vscjava.vscode-java-pack"],
      "settings": {
        "java.debug.settings.console": "integratedTerminal"
      }
    },
    "codespaces": {
      "openFiles": ["README.md", "EulersMethod.java"]
    }
  },
  "postAttachCommand": "echo \"\\nTo start the calculator, type:  java EulersMethod.java\\n\""
}
